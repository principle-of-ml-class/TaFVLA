  "adaptations": [
    "stage4 classify and train raw second-difference noise/IQR: same formulas, .2/.3 windows only, snake_case phases; strict finite/timestamp validation and explicit short-episode diagnostics added",
    "stage6 fuse: exhaustive same symmetric truth table; no post-fusion smoothing",
    "preprocessing: _select_sign correlation rule and low-pressure .10 quantile median baseline only; no Savitzky-Golay or contact exclusion",
    "stage7: retain 5-percent validation rule and oracle interpretation, compute N from local seed42 validation instead of upstream hardcoded policy or multi-seed results",
    "visualization: adapt heatmap/two-row wrench timeline ideas; local prepared labels and episode readers replace external data/config dependencies; phase colors follow requested orange/green/purple/gray"
  ],
  "external_runtime_dependencies": false
